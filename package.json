{
  "name": "tanacode",
  "version": "1.2.0",
  "private": true,
  "description": "Claude Code の中身が、奥まで見える macOS アプリ",
  "license": "MIT",
  "author": "Shunya Tanaka",
  "homepage": "https://github.com/sny-tanaka/tanacode",
  "repository": {
    "type": "git",
    "url": "https://github.com/sny-tanaka/tanacode.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-permissions.mjs",
    "predev": "node scripts/build-translate-helper.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/build-translate-helper.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:cli": "vitest run --config vitest.cli.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "coverage": "vitest run --coverage",
    "coverage:cli": "vitest run --config vitest.cli.config.ts --coverage",
    "coverage:report": "node scripts/coverage-report.mjs",
    "mutation": "node scripts/mutation.mjs",
    "predist": "node scripts/build-translate-helper.mjs",
    "dist": "electron-vite build && node scripts/electron-builder.mjs --mac",
    "install-app": "npm run dist && node scripts/install-app.mjs",
    "icon": "electron scripts/make-icon.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "screenshot": "electron scripts/capture-screenshot.mjs",
    "demo:dev": "vite --config vite.demo.config.ts",
    "demo:build": "vite build --config vite.demo.config.ts",
    "demo:check": "electron --no-sandbox scripts/check-demo-tour.mjs",
    "demo:check:sp": "node scripts/check-demo-tour-sp.mjs",
    "prerelease": "node scripts/build-translate-helper.mjs --require && node scripts/electron-builder.mjs --require --check",
    "release": "electron-vite build && node scripts/electron-builder.mjs --require --mac zip pkg --publish never -c.directories.output=release --arm64 && node scripts/electron-builder.mjs --require --mac zip pkg --publish never -c.directories.output=release --x64"
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "diff": "^9.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "istanbul-lib-coverage": "^3.2.2",
    "jsdom": "^29.1.1",
    "marked": "^18.0.14",
    "marked-cjk-friendly": "^0.1.2",
    "mermaid": "^12.1.0",
    "monaco-editor": "^0.57.0",
    "playwright": "^1.56.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup-plugin-license": "^3.7.1",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "dev.tanacode.app",
    "productName": "tanacode",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "LICENSE.electron.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "LICENSES.chromium.html"
      },
      {
        "from": "out/renderer/THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "build/native/tanacode-translate",
        "to": "tanacode-translate"
      }
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "pkg": {
      "installLocation": "/Applications",
      "isRelocatable": false,
      "identity": null
    }
  }
}
